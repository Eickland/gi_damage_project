"""
Отряд звёздного проводника: Сайно / Анастасия / Даника / Одетта.

Ротация: Одетта EE / Даника EQ / Анастасия EQ / Сайно QE (N2 CA N4 E)×3.
Реакций, наносящих урон, нет. Резонанс — крио и электро (2 + 2).

Анастасия — саппорт (Милосердие), корона — 10 атак вне поля.
An Unfinished Requiem: +1 стак Polestar всем ударам SC отряда — каждый
персонаж берётся через polar_shift() (отдельное комбо с +1 стаком).

Артефакты: Анастасия — Звёздный сет, Даника — Сердце горна,
остальные — Разочарование (у Одетты не Сердце горна, чтобы не было двух
отрядных баффов 4ч).

C2 Даники (если включить danika_c=2): стаки C2 — Сайно 10, Одетта 7,
Анастасия 7, Даника 7.
"""

from __future__ import annotations

from typing import Dict, Sequence

from ...core.buffs import OTHERS, SELF, TEAM, Buff, temp
from ...core.engine import Config, Team
from ...core.entities import Build, Enemy
from ...core.sources import occ
from ...core.stats import S
from ...core.utilits import merge_dicts
from ...data.artifacts import *
from ...data.artifacts_presets import *
from ...data.tags import *
from ...data.characters.cyno import CYNO_COMBO_DICT
from ...data.characters.odette import (odette_burst_buffs, ODETTE_BURST_TIME,
                                       ODETTE_COMBO_DICT, ODETTE_BURST_SOURCES)
from ...data.characters.danika import (DANIKA_COMBO_DICT, C2_ACTIVE_STACKS,
                                       C2_OTHER_STACKS, tag_stellar_conduct_hits)
from ...data.characters.anastasia import anastasia_support, polar_shift, CROWN_HITS
from ...data.weapons import *

TEAM_BUFFS = (
    Buff(S.CRIT_VALUE, 0.30, target=TEAM,
         source="Крио резонанс: +15% крит. шанса (0.30 крит-вэлью)"),
)

#: Время каждого персонажа в ротации (секунды)
TIMES = {"Сайно": 15.0, "Анастасия": 3.0, "Даника": 3.0, "Одетта": 2.4}

ROTATION = "Одетта EE/Даника EQ/Анастасия EQ/Сайно QE (N2 CA N4 E)×3"

MAIN_ATK = {S.ATK_PCT: 0.466 * 2, S.CRIT_VALUE: 0.622}       # АТК/АТК/крит
FULL_ATK = {S.ATK_PCT: 0.466 * 3}                            # АТК/АТК/АТК (Даника)
MAIN_EM = {S.BASE_EM: 187.0 * 2, S.CRIT_VALUE: 0.622}        # МС/МС/крит (Сайно)

#: Комбо с +1 стаком Polestar (Requiem Анастасии)
CYNO = polar_shift(CYNO_COMBO_DICT["sc_combo"])
ODETTE = polar_shift(ODETTE_COMBO_DICT["odette_ssc_combo_cyno"])
DANIKA = polar_shift(DANIKA_COMBO_DICT["support_eq"])
ANASTASIA = polar_shift(anastasia_support("sc", [occ(CROWN_HITS, OFF)]))


def enemy() -> Enemy:
    return Enemy(res={"anemo": 0.10, "cryo": 0.10, "electro": 0.10},
                 def_mult=0.4875, elevation=0.0)


def _c2(build: Build, hits: int) -> Build:
    return tag_stellar_conduct_hits(build, DANIKA_C2, hits)


def cyno_build(constellation: int = 1, weapon=DEATHMATCH.at(1), artifacts=(DISENCHANTMENT,),
               main_stats=MAIN_EM, danika_c2_hits: int = 0,
               extra_buffs: Sequence[Buff] = ()) -> Build:
    return _c2(Build(
        character=CYNO,
        constellation=constellation,
        weapon=weapon,
        artifacts=artifacts,
        extra_stats=merge_dicts(main_stats, HIGH_SUBSTAT_PRESET),
        extra_buffs=tuple(extra_buffs),
        time=TIMES["Сайно"],
    ), danika_c2_hits)


def anastasia_build(constellation: int = 0, weapon=ARTEMISIA, artifacts=(STELLAR_SET,),
                    main_stats=MAIN_ATK, danika_c2_hits: int = 0,
                    extra_buffs: Sequence[Buff] = ()) -> Build:
    return _c2(Build(
        character=ANASTASIA,
        constellation=constellation,
        weapon=weapon,
        artifacts=artifacts,
        extra_stats=merge_dicts(main_stats, STANDART_SUBSTAT_PRESET),
        extra_buffs=tuple(extra_buffs),
        time=TIMES["Анастасия"],
    ), danika_c2_hits)


def danika_build(constellation: int = 0, weapon=ATONEMENT, artifacts=(HEART_OF_FORGE,),
                 main_stats=FULL_ATK, extra_buffs: Sequence[Buff] = ()) -> Build:
    return _c2(Build(
        character=DANIKA,
        constellation=constellation,
        weapon=weapon,
        artifacts=artifacts,
        extra_stats=merge_dicts(main_stats, STANDART_SUBSTAT_FULL_ATK_PRESET),
        extra_buffs=tuple(extra_buffs),
        time=TIMES["Даника"],
    ), C2_OTHER_STACKS if constellation >= 2 else 0)


def odette_build(constellation: int = 0, weapon=SILVER_LIGHT, artifacts=(DISENCHANTMENT,),
                 use_burst: bool | None = None, danika_c2_hits: int = 0,
                 extra_buffs: Sequence[Buff] = ()) -> Build:
    """use_burst=None — авто: до C4 не применяем, с C4 применяем."""
    if use_burst is None:
        use_burst = constellation >= 4
    return _c2(Build(
        character=ODETTE,
        constellation=constellation,
        weapon=weapon,
        artifacts=artifacts,
        extra_stats=merge_dicts(MAIN_ATK, STANDART_SUBSTAT_PRESET),
        extra_sources=ODETTE_BURST_SOURCES if use_burst else (),
        extra_buffs=tuple(extra_buffs) + (odette_burst_buffs(constellation)
                                          if use_burst else ()),
        time=TIMES["Одетта"] + (ODETTE_BURST_TIME if use_burst else 0.0),
    ), danika_c2_hits)


def make_team(name: str, cyno_c: int = 1, cyno_weapon=DEATHMATCH.at(1),
              anastasia_c: int = 0, anastasia_weapon=ARTEMISIA,
              danika_c: int = 0, danika_weapon=ATONEMENT,
              odette_c: int = 0, odette_weapon=SILVER_LIGHT,
              cyno_artifacts=(DISENCHANTMENT,), anastasia_artifacts=(MILLELITH,),
              danika_artifacts=(HEART_OF_FORGE,), odette_artifacts=(STELLAR_SET,)) -> Team:
    c2 = danika_c >= 2
    return Team(
        name=name,
        builds=[
            cyno_build(cyno_c, cyno_weapon, cyno_artifacts,
                       danika_c2_hits=C2_ACTIVE_STACKS if c2 else 0),
            anastasia_build(anastasia_c, anastasia_weapon, anastasia_artifacts,
                            danika_c2_hits=C2_OTHER_STACKS if c2 else 0),
            danika_build(danika_c, danika_weapon, danika_artifacts),
            odette_build(odette_c, odette_weapon, odette_artifacts,
                         danika_c2_hits=C2_OTHER_STACKS if c2 else 0),
        ],
        enemy=enemy(),
        buffs=TEAM_BUFFS,
        rotation=ROTATION,
        config=Config(),
    )


def team_name(cyno_c: int = 1, cyno_weapon=DEATHMATCH.at(1),
              anastasia_c: int = 0, anastasia_weapon=ARTEMISIA,
              danika_c: int = 0, danika_weapon=ATONEMENT,
              odette_c: int = 0, odette_weapon=SILVER_LIGHT) -> str:
    return (f"C{cyno_c}R{cyno_weapon.refinement} Сайно, "
            f"C{anastasia_c}R{anastasia_weapon.refinement} Анастасия, "
            f"C{danika_c}R{danika_weapon.refinement} Даника, "
            f"C{odette_c}R{odette_weapon.refinement} Одетта")


VARIANTS = ({},)

BASE_NAME = team_name()


def all_teams() -> Dict[str, Team]:
    out: Dict[str, Team] = {}
    for kw in VARIANTS:
        name = team_name(**kw)
        out[name] = make_team(name, **kw)
    return out
