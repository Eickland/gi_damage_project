     def motion_value(self, ctx=None) -> float:
         return self.mv(ctx) if callable(self.mv) else float(self.mv)
 
+    def base_term(self, stats, ctx=None) -> float:
+        """Стат × Множитель + доп. слагаемые от других статов (extra_scaling)."""
