 SESSHOU_SAKURA = "sesshou_sakura"
 
+# --- Валера ------------------------------------ #
+#: Окно «Offensive Directive»: удар активного персонажа, тратящий стак
+#: (электро урон звёздного проводника получает доп. базовый урон от АТК Валеры)
